    {
      "cell_type": "code",
      "source": [
        "filename = input(\"Enter the filename: \")\n",
        "text = input(\"Enter the text you want to save: \")\n",
        "\n",
        "with open(filename, \"w\") as file:\n",
        "    file.write(text)\n",
        "\n",
        "print(f\"File '{filename}' created successfully!\")"
